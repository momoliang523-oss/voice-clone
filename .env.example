# Fish Audio API Key(必填)
# 获取: https://fish.audio/app/api-keys 注册后创建
FISH_API_KEY=sk-xxxxxxxx

# TTS 模型: s2.1-pro-free(免费,默认)/ s2.1-pro(付费,音质更好,需 API 余额)
FISH_MODEL=s2.1-pro-free

# 网站对外地址(扣子插件会用这个地址拼音频 URL)
# 本地默认即可;接扣子时改成 cpolar 隧道或你的域名,例如 https://xxxx.cpolar.top
PUBLIC_BASE_URL=http://localhost:8000

# 可选:配置后扣子插件接口(/api/v1/*)需要 X-API-Key 头
# API_KEY=

# 公开模式: 部署给别人用时设为 1,禁用克隆/删除/同步,合成接口按 IP 限流
# PUBLIC_MODE=0
# TTS_RATE_LIMIT_PER_HOUR=60

# 生成音频保留天数,超期自动清理
AUDIO_EXPIRE_DAYS=30
